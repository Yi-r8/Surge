#!name=Surge 内存面板
#!desc=在策略选择视图用一个面板显示 Surge 引擎内存：一条进度条，实心段是当前占用、阴影段延伸到峰值；iOS 需有效订阅
#!author=小慧
#!homepage=https://github.com/Yi-r8/Surge/blob/main/sgmodule/SurgeMemoryPanel.sgmodule
#!category=工具
#!system=ios
#!version=2026-11-12-v3

# ============ 版本说明 ============
# v3（2026-11-12）：改成一个面板。一条 16 格进度条：█ 实心段到当前占用，
#   ▓ 阴影段从当前值延伸到峰值，░ 是未用部分；峰值用 $persistentStore
#   持久化，引擎重启自动重置。面板文字是纯文本，条的颜色用深浅方块区分。
# v2（2026-11-12）：两个面板（当前/峰值各一），已废弃。
# v1（2026-11-12）：单个面板，只有当前占用。
#
# ============ 说明 ============
# 信息面板（Information Panel）显示在 iOS 的策略选择视图里。
# 面板内容由 generic 脚本生成：脚本用 $httpAPI（无需鉴权）读
# /v1/metrics 的 surge_memory_bytes，失败时改调 /v1/mcp 的
# dump_runtime_data。update-interval=60：每次切到策略选择视图
# 且超过 60 秒未更新时自动刷新；点面板刷新按钮立即刷新。
# 注意：手册说 iOS 上信息面板需要有效订阅（2021-09-22 之后到期），
# 订阅过期时面板不显示，不影响其他功能。

[Panel]
Surge 内存 = title="Surge 内存",content="加载中…",script-name=surge-memory-panel,update-interval=60

[Script]
surge-memory-panel = type=generic,script-path=https://raw.githubusercontent.com/Yi-r8/Surge/main/scripts/surge-memory-panel.js
