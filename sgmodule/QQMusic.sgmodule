#!name=QQ音乐去广告
#!desc=屏蔽QQ音乐广告接口：腾讯音乐广告 tmead.y.qq.com / music.y.qq.com、广点通 GDT、c6/szc6.y.qq.com 的 fcg_get_advert。Surge 专用，无外部脚本
#!author=小慧 (抓包自 QQ音乐 2026-11-11 会话 2026-11-11-010745、011612)
#!homepage=https://github.com/Yi-r8/Surge/blob/main/sgmodule/QQMusic.sgmodule
#!category=去广告
#!version=2026-11-14-v3
#!openUrl=https://y.qq.com/

# ============ 抓包依据 ============
# 会话 2026-11-11-010745（2026-11-11 01:08 CST，92 条请求）：
#   tmead.y.qq.com 15 条：POST /maproxy/getPbCompressAd 4 次（拿广告，
#     响应 206 字节 gzip 压缩 protobuf）、/maproxy/getInfo 3 次、
#     /mareportsimp/ReportSimpleBatch 7 次、/mareportbatch/actionPb 1 次
#   c6.y.qq.com 1 条：POST /tips/fcgi-bin/fcg_get_advert.fcg（拿广告）
#   xs.gdt.qq.com 2 条：/style_factory/module_list、template_list（广点通模板）
#   rpt.gdt.qq.com 2 条：/creative_view、/monitor_report_process（广点通上报）
#   tangram.e.qq.com 2 条：/updateSetting（腾讯广告 SDK）
#   sdkreport.e.qq.com 1 条：/link_event
# 会话 2026-11-11-011612（2026-11-11 01:16 CST，99 条请求，v1 已装）：
#   v1 已拦住：tmead.y.qq.com（8 条全 REJECT-DROP）、xs.gdt.qq.com、
#     tangram.e.qq.com、sdkreport.e.qq.com、rpt.gdt.qq.com、tmeadquic QUIC、
#     c6.y.qq.com fcg_get_advert（URL Rewrite 生效，rejected=True）
#   v1 漏掉（全 DIRECT，未拦）：
#     music.y.qq.com 8 条：/maproxy/getPbCompressAd 3 次、/maproxy/getInfo 3 次、
#       /mareportbatch/actionPb 1 次、/mareportbatch/reportPb 1 次
#       —— tmead 被拦后，QQ音乐切到 music.y.qq.com 这个备用广告域，
#       同一套接口路径，只是换了域名。
#     szc6.y.qq.com 1 条：POST /tips/fcgi-bin/fcg_get_advert.fcg
#       —— c6.y.qq.com 的备用域名，同样的拿广告接口。
# 不拦：u6.y.qq.com/cgi-bin/musics.fcg（43 条，音乐正经接口）、
#   stat6.y.qq.com、monitor.music.qq.com、szmg.qq.com（统计/监控）。
# 注意：rpt.gdt.qq.com、xs.gdt.qq.com 已被酷安模块的
#   DOMAIN-SUFFIX,gdt.qq.com 拦掉；tangram/sdkreport.e.qq.com 已被
#   DOMAIN-SUFFIX,e.qq.com 拦掉。这里重复写一份，模块可独立使用。
# 待抓：首页广告没抓到——会话 011612 在开屏就满 100 条自动关闭了，
#   首页的广告接口还没看到，下次要在进首页后再开抓包单独抓。

[Rule]
# ============ 腾讯音乐广告（TME Ad，主接口）============
DOMAIN-SUFFIX,tmead.y.qq.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,tmead.y.qq.com),(PROTOCOL,QUIC)),REJECT-DROP
# v2 新增：tmead 被拦后的备用广告域，同样的接口路径
DOMAIN-SUFFIX,music.y.qq.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,music.y.qq.com),(PROTOCOL,QUIC)),REJECT-DROP

# ============ 优量汇 / 腾讯广告（GDT）============
DOMAIN-SUFFIX,gdt.qq.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,gdt.qq.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,gdtimg.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,gdtimg.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN,tangram.e.qq.com,REJECT-DROP
AND,((DOMAIN,tangram.e.qq.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN,sdkreport.e.qq.com,REJECT-DROP
AND,((DOMAIN,sdkreport.e.qq.com),(PROTOCOL,QUIC)),REJECT-DROP

[URL Rewrite]
# c6/szc6.y.qq.com 的拿广告接口：只拦这一条路径，不拦整个域名
# （c6.y.qq.com 上还有 3g_device_token_reg 等非广告接口）
^https://c6\.y\.qq\.com/tips/fcgi-bin/fcg_get_advert\.fcg _ reject
^https://szc6\.y\.qq\.com/tips/fcgi-bin/fcg_get_advert\.fcg _ reject

[MITM]
hostname = %APPEND% c6.y.qq.com, szc6.y.qq.com
