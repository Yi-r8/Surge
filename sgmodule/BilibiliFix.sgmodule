#!name=哔哩哔哩 𝕏
#!desc=[白B专用] 哔哩哔哩增强版：包含SponsorBlock空降助手、新版gRPC卡片分区与多级子分类优化(含港澳台及快捷访问)、扫码登录原生签名修复、新版多Tab分类收藏升级、1080P高码率画质解锁、大会员凭证解锁。
#!author=小慧 (转换自 TomCatXue)
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=去广告
#!version=2026-11-15-v2
#!openUrl=https://apps.apple.com/app/id736536022
#!arguments=sponsorBlock:bilibili.airborne,displayUpList:auto,purifyComment:true,optimizeRequest:bilibili.protobuf.request,sponsorBlockPolicy:HK,VIP:false,Authorization:"",UserAgent:"",logLevel:error
#!arguments-desc=sponsorBlock/optimizeRequest：改成 # 关闭对应脚本\nsponsorBlockPolicy：空降助手服务器走哪个策略，默认 HK，可改 DIRECT 或任意策略组名\nVIP：true 开启凭证注入，需填 Authorization

[Rule]
# 空降助手服务器：策略由 sponsorBlockPolicy 参数控制（默认 HK）
DOMAIN,bsbsb.top,{{{sponsorBlockPolicy}}}
# 阻止B站备用域名访问
DOMAIN,api.biliapi.com,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.net,REJECT
# 禁用STUN & P2P
AND,((DOMAIN-SUFFIX,chat.bilibili.com),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,tracker),(DOMAIN-KEYWORD,p2p)))),REJECT

[URL Rewrite]
# 废弃专题中心/公开课 H5 重定向
(?i)^https:\/\/www\.bilibili\.com\/h5\/mooc.*$ https://m.bilibili.com/cheese/home?navhide=1 302
(?i)^https:\/\/www\.bilibili\.com\/h5\/musicplus.*$ https://www.bilibili.com/v/popular/rank/music 302
# 渠道转为国际版
(?i)^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\?(.*)&mobi_app=iphone&(.*)$ https://api.bilibili.com/pgc/page/channel?$1&mobi_app=iphone_i&$2

[Header Rewrite]
# gRPC 分区接口补充 grpc-status=0，防止新版客户端因缺少状态头触发错误断流
http-response (?i)^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.show\.v1\.(Mixture\/(RegionIndex|RegionList)|Rank\/RankRegionList)$ header-add 'grpc-status' '0'

[Body Rewrite]
# 移除直播间广告：tracker 域名改写
http-response-jq (?i)^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\? '.data.domains=["wss://tracker.chat.bilibili.com"]'
# 移除开屏广告：清空 show/event_list
http-response-jq (?i)^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|event\/list2)\? '.data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)'
# 移除播放页开通会员横幅
http-response-jq (?i)^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'
http-response-jq (?i)^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\? '.data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)'
# 阻断 STUN 实时通信 P2P 穿透
http-response-jq (?i)^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\? '.data[][]?="stun.chat.bilibili.com:3478"'
# 移除首页推荐流商业/活动广告，仅保留普通视频
http-response-jq (?i)^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\? 'if .data.items then .data.items |= map(select((.banner_item == null) and (.ad_info == null) and (.card_goto == "av") and (.card_type | IN("small_cover_v2", "large_cover_single_v9", "large_cover_v1")))) end'
# 移除 Story 竖屏流商业插播广告
http-response-jq (?i)^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\? 'if .data.items then .data.items |= map(select((.ad_info == null) and (.card_goto | IN("vertical_ad_av", "vertical_ad_live", "vertical_ad_picture") | not)) | del(.story_cart_icon, .free_flow_toast, .image_infos, .course_info, .game_info)) end'
# 我的页面升级为新版多 Tab 分类收藏
http-response-jq (?i)^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine(?:\/ipad)?\? 'if .data.sections_v2 then .data.sections_v2 |= map(.items |= map(if .title == "我的收藏" or .id == 496 or .id == 3072 then .uri = "bilibili://user_center/favourite?version=2" else . end)) end | if .data.ipad_sections then .data.ipad_sections |= map(if .title == "我的收藏" or .id == 749 then .uri = "bilibili://user_center/favourite?version=2" else . end) end'
# 非会员开启会员专属清晰度（本地 UI 显示）
http-response-jq (?i)^https:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\? '.data.vip |= if . != null and .status == 0 then . + { status: 1, type: 2, due_date: 9005270400000, role: 15 } else . end'

[Map Local]
# 移除直播广告：购物信息回空
(?i)^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" status-code=200 header="Content-Type: application/json"
# 移除直播间游戏推广
(?i)^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\? data-type=text data="{}" status-code=200 header="Content-Type: application/json"
# 移除开屏广告
(?i)^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\? data-type=text data="{"code":0,"message":"OK","ttl":1,"data":{"max_time":0,"min_interval":31536000,"pull_interval":31536000,"keep_ids":[],"show":[],"list":[{}],"splash_request_id":""}}" status-code=200 header="Content-Type: application/json"
# 移除大会员广告、右上角活动入口
(?i)^https:\/\/ap[ip]\.bilibili\.com\/x\/(?:resource\/(?:top\/activity|patch\/tab(?:\/v2)?)|v2\/search\/square|vip\/ads\/materials)\? data-type=text data="{"code":-404,"message":"-404","ttl":1,"data":null}" status-code=200 header="Content-Type: application/json"
# 修复废弃专题接口
(?i)^https:\/\/api\.bilibili\.com\/topic\/getlist\? data-type=text data="{"code":0,"message":"0","ttl":1,"data":{"list":[],"total":0}}" status-code=200 header="Content-Type: application/json"
# 移除播放页开通会员横幅
(?i)^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? data-type=text data="{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}" status-code=200 header="Content-Type: application/json"
# 移除青少年模式弹窗
(?i)^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$ data-type=base64 data="AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA" header="content-type: application/grpc|grpc-status: 0"
# 移除搜索框默认词
(?i)^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ data-type=base64 data="AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=" header="content-type: application/grpc|grpc-status: 0"
# 移除视频播放结束推广/追番/点赞推荐卡片
(?i)^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$ data-type=base64 data="AAAAAAA=" header="content-type: application/grpc|grpc-status: 0"

[Script]
# 分区列表优化：首页分区入口
bilibili.region.tab = type=http-response,pattern=(?i)^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\?,requires-body=true,timeout=10,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/bilibili/bilibili_region.js?v=77318078
# 分区列表优化：全部分区 (gRPC)
bilibili.region.list = type=http-response,pattern=(?i)^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList(?:\?.*)?$,requires-body=true,binary-body-mode=true,timeout=10,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/bilibili/bilibili_region.js?v=77318078
# 分区列表优化：快捷分区保存
bilibili.region.shortcut = type=http-request,pattern=(?i)^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut(?:\?.*)?$,timeout=10,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/bilibili/bilibili_region.js?v=77318078
# 分区列表优化：分区列表修复 (HTTP)
bilibili.region.http = type=http-response,pattern=(?i)^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/(channel\/region\/list|region\/index)\?,requires-body=true,timeout=10,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/bilibili/bilibili_region.js?v=77318078
# 自动捕获当前用户 access_key（供扫码登录签名生成使用）
bilibili.qrcode.capture = type=http-request,pattern=(?i)^https?:\/\/(?:app|api)\.bilibili\.com\/x\/(?:v2\/account\/mine|v2\/account\/myinfo|member\/app\/nickfree|resource\/show\/tab),max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/bilibili/bilibili_qrcode.js?v=6beeac14
# 扫码登录原生签名生成与授权修复
bilibili.qrcode.fix = type=http-request,pattern=(?i)^https:\/\/passport\.bilibili\.com\/x\/passport-login\/web\/qrcode\/(check|confirm|scene),requires-body=true,timeout=10,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/bilibili/bilibili_qrcode.js?v=6beeac14
# 空降助手：跳过视频内插播广告（把 sponsorBlock 参数值改成 # 可关闭）
{{{sponsorBlock}}} = type=http-request,pattern=(?i)^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$,requires-body=true,binary-body-mode=true,timeout=10,argument="{"logLevel":"{{{logLevel}}}"}",max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.request.js
# 评论区请求优化（把 optimizeRequest 参数值改成 # 可关闭）
{{{optimizeRequest}}} = type=http-request,pattern=(?i)^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$,requires-body=true,binary-body-mode=true,timeout=10,argument="{"purifyComment":{{{purifyComment}}},"logLevel":"{{{logLevel}}}"}",max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.request.js
# 评论区/动态/画质净化
bilibili.protobuf.response = type=http-response,pattern=(?i)^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.(?:show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(?:unite)?\.v1\.View\/(?:View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$,requires-body=true,binary-body-mode=true,argument="{"displayUpList":"{{{displayUpList}}}","purifyComment":{{{purifyComment}}},"sponsorBlock":"{{{sponsorBlock}}}","logLevel":"{{{logLevel}}}"}",max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.response.js
# 移除直播间广告
bilibili.live = type=http-response,pattern=(?i)^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?,requires-body=true,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.json.js
# 大会员专属凭证注入（开关：VIP，需填入 Authorization 凭证）
bilibili.vip = type=http-request,pattern=(?i)^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.net)\/(?:bilibili\.app\.(?:playerunite\.v1\.Player\/PlayViewUnite|playurl\.v1\.PlayURL\/PlayView)|bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView),requires-body=true,binary-body-mode=true,timeout=60,argument="{"Authorization":"{{{Authorization}}}","UserAgent":"{{{UserAgent}}}"}",enabled={{{VIP}}},max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/Yi-r8/Surge/main/scripts/bilibili_vip.js

[MITM]
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com, app.biliapi.net, api.bilibili.com, api.live.bilibili.com, passport.bilibili.com, line3-h5-mobile-api.biligame.com, www.bilibili.com
