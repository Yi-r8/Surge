#!name=香港抖音去广告
#!desc=精简左右侧边栏、移除底栏切换，其余内容后续再完善。
#!author=小慧 (转换自 可莉)
#!homepage=https://kelee.one/Tool/Loon/Lpx/HKDouYin_remove_ads.lpx
#!category=去广告
#!version=2026-11-15-v1
#!openUrl=https://apps.apple.com/app/id1142110895

[Rule]
AND,((IP-CIDR,101.126.58.201/32,no-resolve),(DEST-PORT,6443)),REJECT
AND,((IP-CIDR,110.249.199.75/32,no-resolve),(DEST-PORT,6443)),REJECT
AND,((IP-CIDR,111.225.147.191/32,no-resolve),(DEST-PORT,6443)),REJECT
AND,((IP-CIDR,111.63.61.101/32,no-resolve),(DEST-PORT,6443)),REJECT
AND,((IP-CIDR,220.243.141.0/32,no-resolve),(DEST-PORT,6443)),REJECT
# 原插件一条 OR 嵌套规则，拆成两条 AND（逻辑等价，避开嵌套语法）
AND,((DOMAIN-SUFFIX,bytegecko.com),(DOMAIN-KEYWORD,ncdn)),REJECT
AND,((DOMAIN-SUFFIX,byteeffecttos.com),(DOMAIN-KEYWORD,ncdn)),REJECT

[Map Local]
# Loon reject(404)：404 + 空 body
(?i)^https:\/\/api5-normal-lq\.amemv\.com\/api\/ad\/ data-type=text data="" status-code=404
(?i)^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/api\/ad\/ data-type=text data="" status-code=404
(?i)^https:\/\/zlink\.ugsdk\.cn\/ad\/ data-type=text data="" status-code=404

[Body Rewrite]
# 侧边栏：删最近应用/最近用户
http-response-jq (?i)^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/aweme\/homepage\/sidebar_data\/\? 'del(.data_map.recently_apps, .data_map.recently_users)'
# 首页渲染：删 tab_config + 精简侧边栏模块 + 只留直播/关注/热榜三个 tab（原插件两条规则合并成一条，防只生效一条；tab_list 缺失时跳过，防 jq 报错）
http-response-jq (?i)^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/aweme\/homepage\/render\/\? 'del(.data.tab_config) | if .data.tab_list then (.data.tab_list[]? |= (if .extra.side_bar.modules != null then .extra.side_bar.modules[]?.items[]? |= (if .data.first_page_module?.module_title == "常用功能" then .data={} else . end) else . end) | .data.tab_list |= map(if .extra.tab_list != null then .extra.tab_list |= map(select(.tab_id | IN("homepage_tablive", "homepage_follow", "homepage_hot_container"))) else . end) | .data.tab_list |= map(select(.extra.tab_list != null and (.extra.tab_list | length > 0)))) else . end'
# 设置接口：关首页双 tab 皮肤
http-response-jq (?i)^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/tfe\/api\/request_combine\/v1\/\?need_personal_recommend 'if .data["/service/settings/v3/"]?.body?.data?.settings then (.data["/service/settings/v3/"].body.data.settings.homepage_two_session_tab_skin_2025 = false | .data["/service/settings/v3/"].body.data.settings.homepage_tab_skin_enable = false) else . end'

[MITM]
# api5-normal-lq / zlink 插件 MITM 列表里没有，但 /api/ad/ 规则要解密才生效，故补上
hostname = %APPEND% aweme.snssdk.com, api5-normal-m.amemv.com, api5-normal-lq.amemv.com, zlink.ugsdk.cn
