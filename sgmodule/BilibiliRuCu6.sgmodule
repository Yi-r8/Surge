#!name=哔哩哔哩去广告（RuCu6）
#!desc=去开屏、首页推荐、直播间与漫画广告，空降助手跳过视频内插播广告。
#!author=小慧 (转换自 RuCu6)
#!homepage=https://github.com/RuCu6
#!category=去广告
#!version=2026-11-15-v1
#!openUrl=https://apps.apple.com/app/id736536022
#!arguments=displayUpList:"show",optimizeRequest:true,purifyComment:true,sponsorBlock:true,logLevel:"error"

[Rule]
# 空降助手服务器：Loon 原版策略为 PROXY，必须走代理以防连接超时
DOMAIN,bsbsb.top,HK
# P2P 端口：Loon 的 REJECT-NO-DROP 在 Surge 下以 REJECT 翻译
DEST-PORT,4480,REJECT
DEST-PORT,4483,REJECT
DEST-PORT,9102,REJECT
# 禁用 STUN & P2P
AND,((DOMAIN-SUFFIX,chat.bilibili.com),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,tracker),(DOMAIN-KEYWORD,p2p)))),REJECT
# 备用域名
DOMAIN,api.biliapi.com,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,app.biliapi.net,REJECT
# DNS：拒绝 Google DNS，配合下面 resolve 改写逼应用走传统 DNS
DOMAIN,dns.google,REJECT
# 开屏广告视频：Loon 的 REJECT-VIDEO-NO-DROP 在 Surge 下以 REJECT 翻译
URL-REGEX,^http:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH,REJECT
URL-REGEX,^http:\/\/[\d\.]+:8000\/v1\/resource\/\w{32}-1-SPLASH,REJECT

[URL Rewrite]
# 移除直播间链接跟踪参数
(?i)(^https:\/\/live\.bilibili\.com\/\d+)(?:\/?\?.*)$ $1 302
# 移除视频链接跟踪参数
(?i)(^https:\/\/(?:www|m)\.bilibili\.com\/video\/(?:BV\w{10}|av\d{9}))(?:\/?\?.*)$ $1 302

[Body Rewrite]
# DNS：掏空 HTTPDNS 解析结果，逼应用走传统 DNS
http-response-jq (?i)^http:\/\/[^?]+\/resolve\?host=(ap[ip]\.bilibili\.com|grpc\.biliapi\.net|api\.live\.bilibili\.com) '.dns[]? |= (.ips = [] | .ttl = 86400)'
# 移除播放页开通会员横幅
http-response-jq (?i)^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\? '.data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)'
http-response-jq (?i)^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'
# 移除直播间广告（Loon 原版有两条相同规则，Surge 下一条即可，jq 本身幂等）
http-response-jq (?i)^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\? '.data |= (del(.play_together_info, .play_together_info_v2, .activity_banner_info) | if .function_card then .function_card[] = null end | if .new_tab_info.outer_list then .new_tab_info.outer_list |= map(select(.biz_id != 33)) end | if .card_list then .card_list |= map(select(.card_type | IN("banner_v2", "activity_card_v1") | not)) end | reduce ([["show_reserve_status"], false], [["reserve_info", "show_reserve_status"], false], [["shopping_info", "is_show"], 0]) as [$path, $value] (.; if getpath($path) then setpath($path; $value) end))'
# 阻断 STUN 实时通信 P2P 穿透
http-response-jq (?i)^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\? '.data[][]? = "stun.chat.bilibili.com:3478"'
# 移除直播间广告：tracker 域名改写
http-response-jq (?i)^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\? '.data.domains = ["wss://tracker.chat.bilibili.com"]'
# 移除皮肤推送
http-response-jq (?i)^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\? 'del(.data.common_equip)'
# 哔哩哔哩漫画广告
http-response-jq (?i)^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v1\.(?:Comic\/AppInit|Home\/HomeFeed)\? '.data as $data | .data[("activity_tab", "flash", "operate") | select($data[.])]=null | if .data.feeds then .data.feeds |= map(select(.type | IN(15, 30) | not)) end'

[Map Local]
# 开屏广告：阻止峰值资源下载
(?i)^https:\/\/app\.bilibili\.com\/x\/resource\/peak\/download data-type=text data="{}" status-code=200 header="Content-Type: application/json"
# 满意度调研
(?i)^https:\/\/api\.bilibili\.com\/x\/v2\/dm\/qoe\/show\? data-type=text data="{}" status-code=200 header="Content-Type: application/json"
# 大会员广告
(?i)^https:\/\/api\.bilibili\.com\/x\/vip\/ads\/materials\? data-type=text data="{}" status-code=200 header="Content-Type: application/json"
# 直播广告：购物信息回空
(?i)^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" status-code=200 header="Content-Type: application/json"
# IP 请求、地理位置请求
(?i)^https:\/\/api\.bilibili\.com\/x\/web-interface\/zone\?jsonp data-type=text data="{}" status-code=200 header="Content-Type: application/json"
(?i)^https:\/\/app\.bilibili\.com\/x\/resource\/ip data-type=text data="{}" status-code=200 header="Content-Type: application/json"
# 首页标签栏热更新
(?i)^https:\/\/app\.bilibili\.com\/x\/resource\/patch\/tab(\/v2)?\? data-type=text data="{}" status-code=200 header="Content-Type: application/json"
# 移除播放页开通会员横幅
(?i)^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? data-type=text data="{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}" status-code=200 header="Content-Type: application/json"
# 移除右上角活动入口
(?i)^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity\? data-type=text data="{"code":-404,"message":"啥都木有","ttl":1,"data":null}" status-code=200 header="Content-Type: application/json"
# 搜索框填充词
(?i)^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square\? data-type=text data="{"code":0,"message":"0","ttl":1,"data":{"type":"history","title":"搜索历史","search_hotword_revision":2}}" status-code=200 header="Content-Type: application/json"
# 屏蔽默认搜索框关键词
(?i)^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ data-type=base64 data="AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=" header="content-type: application/grpc|grpc-status: 0"
# 青少年模式
(?i)^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$ data-type=base64 data="AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA" header="content-type: application/grpc|grpc-status: 0"
# 视频暂停广告
(?i)^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(?:view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(?:PlayPause|ViewEndPage))$ data-type=base64 data="AAAAAAA=" header="content-type: application/grpc|grpc-status: 0"
# 移除直播间游戏推广
(?i)^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\? data-type=text data="{}" status-code=200 header="Content-Type: application/json"
# 哔哩哔哩漫画开屏与底栏广告
(?i)^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v1\.Comic\/(?:Flash|ListFlash|GetActivityTab|GetBubbles) data-type=text data="{"code":0,"msg":"","data":null}" status-code=200 header="Content-Type: application/json"

[Script]
# 空降助手：跳过视频内插播广告（开关：sponsorBlock）
bilibili.airborne = type=http-request,pattern=(?i)^https:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.(?:app\.view(unite)?\.v1\.View\/ViewProgress|community\.service\.dm\.v1\.DM\/DmSegMobile)$,requires-body=true,binary-body-mode=true,timeout=10,argument="{"logLevel":"{logLevel}"}",enabled={sponsorBlock},script-path=https://rucu6.pages.dev/Scripts/bilibili/request.js
# 评论区加载优化（开关：optimizeRequest）
bilibili.request = type=http-request,pattern=(?i)^https:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.(?:app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$,requires-body=true,binary-body-mode=true,timeout=10,argument="{"purifyComment":{purifyComment},"logLevel":"{logLevel}"}",enabled={optimizeRequest},script-path=https://rucu6.pages.dev/Scripts/bilibili/request.js
# Proto 处理：评论区/动态/画质净化（开关：displayUpList、purifyComment、sponsorBlock）
bilibili.response = type=http-response,pattern=(?i)^https:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.(?:app\.(?:dynamic\.v2\.Dynamic\/DynAll|playerunite\.v1\.Player\/PlayViewUnite|playurl\.v1\.PlayURL\/PlayView|show\.v1\.Popular\/Index|view(unite)?\.v1\.View\/(?:AIRelateAsync|RelatesFeed|View|ViewProgress))|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView|polymer\.app\.search\.v1\.Search\/SearchAll)$,requires-body=true,binary-body-mode=true,timeout=10,argument="{"displayUpList":"{displayUpList}","purifyComment":{purifyComment},"sponsorBlock":{sponsorBlock},"logLevel":"{logLevel}"}",script-path=https://rucu6.pages.dev/Scripts/bilibili/response.js
# 移除观影页广告
bilibili.json.bangumi = type=http-response,pattern=(?i)^https:\/\/api\.bilibili\.com\/pgc\/page\/(?:bangumi|cinema\/tab),requires-body=true,timeout=10,script-path=https://rucu6.pages.dev/Scripts/bilibili/json.js
# 移除开屏广告
bilibili.json.splash = type=http-response,pattern=(?i)^https:\/\/app\.bilibili\.com\/x\/v2\/splash,requires-body=true,timeout=10,script-path=https://rucu6.pages.dev/Scripts/bilibili/json.js
# 精简首页顶部标签
bilibili.json.tab = type=http-response,pattern=(?i)^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?,requires-body=true,timeout=10,script-path=https://rucu6.pages.dev/Scripts/bilibili/json.js
# 精简我的页面
bilibili.json.mine = type=http-response,pattern=(?i)^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine,requires-body=true,timeout=10,script-path=https://rucu6.pages.dev/Scripts/bilibili/json.js
# 移除首页推荐广告
bilibili.json.feed = type=http-response,pattern=(?i)^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index,requires-body=true,timeout=10,script-path=https://rucu6.pages.dev/Scripts/bilibili/json.js

[MITM]
hostname = %APPEND% api.bilibili.com, app.bilibili.com, grpc.biliapi.net, api.live.bilibili.com, live.bilibili.com, line3-h5-mobile-api.biligame.com, m.bilibili.com, manga.bilibili.com, www.bilibili.com
