#!name=拼多多优化
#!desc=拼多多广告拦截及页面精简
#!category=去广告

[Rule]
AND,((URL-REGEX,^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(http:\/\/[\d\.]+)?\/d4?\?), (USER-AGENT,*com.xunmeng.pinduoduo*)),REJECT

AND,((URL-REGEX,^http:\/\/\[(([0-9A-Fa-f]{1,4}:){7}([0-9A-Fa-f]{1,4}|:)|.*)\](\/v\d+)?\/d\d?\??), (USER-AGENT,*com.xunmeng.pinduoduo*)),REJECT

[Script]
拼多多请求拦截 = type=http-request,pattern=^https:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/(?:cappuccino\/splash|alexa\/(?:cells\/hub|goods\/back_up)|aquarius\/hungary\/global\/homepage|brand-olay\/goods_detail\/bybt_guide|buffon\/nasus\/recommend|caterham\/v3\/query\/|dunkirk\/subaru\/goods_list_v2|engels\/reviews\/require\/append|express\/post\/landing_page\/ad\/recommend_goods_list\/pickup_identity_code|flow\/hungary\/window\/global\/v2|zaire_biz\/chat\/resource\/get_list_data|xrec\/goods_rec\/pay_after_use_v2),script-path=https://你的脚本地址/pdd.js

拼多多搜索热词拦截 = type=http-request,pattern=^https:\/\/api\.pinduoduo\.com\/search_hotquery\?,script-path=https://你的脚本地址/pdd.js

拼多多页面精简 = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/api\/(?:oak\/integration\/render|philo\/personal\/hub\?|search),requires-body=true,script-path=https://你的脚本地址/pdd.js