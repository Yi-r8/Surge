#!name=酷安去广告
#!desc=去除酷安开屏广告、首页信息流、话题热议、搜索热词、我的页面推广卡片、帖子详情好物/赞助卡及评论区广告卡。Surge 专用，无外部脚本
#!author=小慧 (转换自 ZenmoFeiShi / 怎么肥事、walala，feed/detail 与 replyList 补自 myouhi / xiaomaoJT 的公开去广告逻辑)
#!homepage=https://github.com/ZenmoFeiShi/Qx/blob/main/KuAn.snippet
#!category=去广告
#!system=ios
#!version=2026-11-09-v5
#!openUrl=https://www.coolapk.com/

# ============ 版本说明 ============
# v5（2026-11-09）本次修正：
#   1. 【新增域名】补上 api-access.pangolin-sdk-toutiao1.com
#      抓包 100 条请求发现，该域名被请求 9 次，是穿山甲的备用域。
#      原规则只写了 pangolin-sdk-toutiao.com（无 1），后缀匹配不到 -toutiao1.com。
#   2. 【新增域名】补上 tnc3-alisc1.zijieapi.com（字节域名调度服务）
#      开屏时 SDK 会用它获取可用的广告域名列表，绕过前面的域名拦截。
#   3. 【新增域名】补上 sdk-config.tanx.com（阿里 TanX 广告）
#   4. 【改为 REJECT-DROP】穿山甲 / 优量汇 的核心域名
#      抓包显示这些请求即便被 REJECT，SDK 仍在疯狂重试（单次开屏 100 条请求中
#      有 60+ 条是广告 SDK 的重试）。REJECT-DROP 静默丢包，不返回 RST，
#      可显著减少重试风暴，是开屏卡顿的主因之一。
#      注意：代价是客户端要等超时，但广告 SDK 本身就会超时，体感无差异。
#
# v4（2026-11-09）：
#   1. 修复 [URL Rewrite] 语法错误（原写法 `- reject-dict` 是 Loon 语法，
#      Surge 不认，导致整个 [URL Rewrite] 段被跳过）
#   2. 新增开屏广告拦截：main/init 的 extraDataArr 里 17 个 SplashAd.* / Ad.SPLASH* 键
#
# [Rule] 是全局生效的：这几家 SDK 的广告在其他 App 里也会一并被拦。

[Rule]
# ============ 穿山甲 / Pangle / GroMore（字节）============
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,pangolin-sdk-toutiao.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,pglstatp-toutiao.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,pangle.io,REJECT-DROP
AND,((DOMAIN-SUFFIX,pangle.io),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN,ad.toutiao.com,REJECT-DROP
AND,((DOMAIN,ad.toutiao.com),(PROTOCOL,QUIC)),REJECT-DROP
# 字节域名调度（SDK 用它换取可用广告域名，会绕过域名拦截）
DOMAIN-SUFFIX,zijieapi.com,REJECT-DROP
DOMAIN-SUFFIX,zijieapi.net,REJECT-DROP

# ============ 优量汇 / 腾讯广告（GDT）============
DOMAIN-SUFFIX,gdt.qq.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,gdt.qq.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,gdtimg.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,gdtimg.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,pgdt.gtimg.cn,REJECT-DROP
AND,((DOMAIN-SUFFIX,pgdt.gtimg.cn),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,ad.qq.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,ad.qq.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,e.qq.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,e.qq.com),(PROTOCOL,QUIC)),REJECT-DROP

# ============ 阿里 TanX ============
DOMAIN-SUFFIX,tanx.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,tanx.com),(PROTOCOL,QUIC)),REJECT-DROP

# ============ 快手联盟 ============
DOMAIN-SUFFIX,kuaishouzt.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,kuaishouzt.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,open.e.kuaishou.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,open.e.kuaishou.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,kwaiad.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,kwaiad.com),(PROTOCOL,QUIC)),REJECT-DROP
DOMAIN-SUFFIX,adkwai.com,REJECT-DROP
AND,((DOMAIN-SUFFIX,adkwai.com),(PROTOCOL,QUIC)),REJECT-DROP

[URL Rewrite]
# 穿山甲广告 SDK：直接拒绝
^https?://api-access\.pangolin-sdk-toutiao\.com/api/ad/union/sdk _ reject

[Map Local]
# 搜索热词：返回空对象
(?i)^https://api\.coolapk\.com/v6/search\?.*type=hotSearch data-type=text data="{}" status-code=200 header="Content-Type: application/json"

[Body Rewrite]
# 开屏广告：删掉 main/init 里的 SplashAd.* / Ad.SPLASH* / Ad.PRELOAD* 配置
# 实测这 17 个键控制开屏：SplashAd.Type / Expires / onResume / resumeType / resumeExpires
# / openType / sensorDelay / sensitivity / timeout / hType，Ad.PRELOAD / PRELOAD_AFTER_USE
# / PRELOAD_THRESHOLD / PRELOAD_THRESHOLD_IOS / SPLASH_DOWNLOAD_POPUP / SPLASH_RETRY_PERIOD / ADLOAD_POS_ID
http-response-jq ^https://api\.coolapk\.com/v6/main/init '.data[].extraDataArr |= with_entries(select(.key | (startswith("SplashAd") or startswith("Ad.PRELOAD") or startswith("Ad.SPLASH") or startswith("Ad.ADLOAD")) | not)) | del(.data[]? | select(.entityId == 944 or .entityId == 945 or .entityId == 24455 or .entityId == 36839 or .entityId == 1635 or .title == "关注")) | .data |= map(if .entities then .entities |= map(select(.entityId != 1635 and .entityId != 2261 and .entityId != 1633 and .entityId != 413 and .entityId != 417 and .entityId != 1754 and .entityId != 1966 and .entityId != 2274 and .entityId != 1170 and .entityId != 1175 and .entityId != 1190 and .entityId != 2258 and .title != "关注")) else . end)'
# 首页信息流 indexV8：去掉"值得买 / 红包"类推广及 sponsorCard
http-response-jq ^https://api\.coolapk\.com/v6/main/indexV8 '.data |= map(select((.entityId != 32557 and .entityId != 29349 and .entityId != 28621) and (.entityTemplate != "sponsorCard") and (.title | test("值得买|红包") | not)))'
# 列表页 dataList：去掉"话题热议"、推广卡片及 sponsorCard
http-response-jq ^https://api\.coolapk\.com/v6/page/dataList '.data |= map(select(.title != "话题热议" and (.entityTemplate != "sponsorCard") and (.entityId != 36104 and .entityId != 24309 and .entityId != 12889 and .entityId != 21063 and .entityId != 35730 and .entityId != 35846 and .entityId != 28374 and .entityId != 28375 and .entityId != 27332 and .entityId != 20090 and .entityId != 28773 and .entityId != 29343 and .entityId != 21106)) | if .entities then (.entities |= map(select(.title != "睡个好觉需要什么？" and .entityTemplate != "sponsorCard"))) else . end)'
# 我的页面卡片配置：去掉 textLink 类推广入口
http-response-jq ^https://api\.coolapk\.com/v6/account/loadConfig\?key=my_page_card_config '.data |= map(select(.entityType != "textLink" and (.entityId != 1001 and .entityId != 1003 and .entityId != 1004 and .entityId != 1005)) | if .entities then .entities |= map(select(.entityType != "textLink")) else . end)'
# 帖子详情 feed/detail：清空好物卡与赞助卡，过滤无 id 的热门/置顶回复
http-response-jq ^https://api\.coolapk\.com/v6/feed/detail '.data.include_goods = [] | .data.include_goods_ids = [] | .data.detailSponsorCard = [] | if .data.hotReplyRows then .data.hotReplyRows |= map(select(.id != null)) else . end | if .data.topReplyRows then .data.topReplyRows |= map(select(.id != null)) else . end'
# 评论列表 feed/replyList：只保留有 id 且不是 card 型的正常回复
http-response-jq ^https://api\.coolapk\.com/v6/feed/replyList '.data |= map(select(.id != null and .entityType != "card") | if .replyRows then .replyRows |= map(select(.id != null and .entityType != "card")) else . end)'

[MITM]
hostname = %APPEND% api.coolapk.com
