#!name=Surge 内存详情
#!desc=在策略选择视图显示 Surge 引擎内存详情：一条横线进度条（粗实线当前占用、粗虚线延伸到峰值）+ 占用构成的条数明细（DNS 缓存、虚拟 IP、活动请求、临时规则、封禁）；独立模块，和“Surge 内存面板”分开； iOS 需有效订阅
#!author=小慧
#!homepage=https://github.com/Yi-r8/Surge/blob/main/sgmodule/SurgeMemoryPanelDetail.sgmodule
#!category=工具
#!system=ios
#!version=2026-11-12-v1

# ============ 说明 ============
# 信息面板（Information Panel）显示在 iOS 的策略选择视图里。
# 面板内容由 generic 脚本生成：脚本用 $httpAPI（无需鉴权）读数据。
# update-interval=60：每次切到策略选择视图且超过 60 秒未更新时自动
# 刷新；点面板刷新按钮立即刷新。
# 注意：手册说 iOS 上信息面板需要有效订阅（2021-09-22 之后到期），
# 订阅过期时面板不显示，不影响其他功能。

[Panel]
Surge 内存详情 = title="Surge 内存详情",content="加载中…",script-name=surge-memory-panel-detail,update-interval=60

[Script]
surge-memory-panel-detail = type=generic,script-path=https://raw.githubusercontent.com/Yi-r8/Surge/main/scripts/surge-memory-panel-detail.js
